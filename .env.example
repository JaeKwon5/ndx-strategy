# ==========================================================
# 1. 텔레그램 알림 설정 (가장 간편하고 토큰 만료가 없어 추천)
# ==========================================================
# 1) 텔레그램에서 @BotFather 검색 -> /newbot 입력 -> 봇 생성 후 HTTP API Token 복사
# 2) 생성한 봇에게 아무 메시지나 1회 전송
# 3) 브라우저에서 https://api.telegram.org/bot<토큰>/getUpdates 접속 후 "chat":{"id": 숫자} 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================================
# 2. 카카오톡 '나에게 보내기' 설정 (선택 사항)
# ==========================================================
# 카카오 디벨로퍼스(https://developers.kakao.com) 앱 생성 -> 카카오 로그인 활성화
# -> 동의항목에서 '카카오톡 메시지 전송(talk_message)' 활성화 후 발급받은 키 입력
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
KAKAO_ACCESS_TOKEN=
